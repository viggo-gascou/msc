#!/bin/bash

#SBATCH --job-name=semedit-finetune-resume
#SBATCH --output=logs/SLURM/finetune-resume.%j.out
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:a100_40gb:4
#SBATCH --time=1-00:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-type=BEGIN,END

## SETUP

module load uv/0.7.13-GCCcore-14.2.0

export UV_NO_SYNC=1
export UV_OFFLINE=1
export WANDB_JOB_TYPE=fine-tuning
export OMP_NUM_THREADS=4
export NO_ALBUMENTATIONS_UPDATE=1

## RUN

echo "Running on $(hostname):"
nvidia-smi --query-gpu=index,gpu_name,memory.total --format=csv,noheader,nounits | awk -F',' '{printf "  GPU %s: %s (%s MiB)\n", $1, $2, $3}'
VRAM_TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | awk '{s+=$1} END {print s}')
echo "Total VRAM: ${VRAM_TOTAL} MiB across $(nvidia-smi --query-gpu=name --format=csv,noheader | wc -l) GPUs"

echo "Activating virtual environment..."
source .venv/bin/activate

FINETUNE_CKPT_DIR=$(ls -d checkpoints/${FINETUNE_JOB_ID}_* 2>/dev/null | head -1)
if [ -z "$FINETUNE_CKPT_DIR" ]; then
    echo "ERROR: no checkpoint directory found for job ${FINETUNE_JOB_ID}"
    exit 1
fi
RESUME_CKPT="${FINETUNE_CKPT_DIR}/checkpoint_latest.pt"
if [ ! -f "$RESUME_CKPT" ]; then
    echo "ERROR: checkpoint_latest.pt not found in ${FINETUNE_CKPT_DIR}"
    exit 1
fi
echo "Resuming from: ${RESUME_CKPT}"

echo "Setup complete, running script at $(date)"
accelerate launch --multi_gpu \
    --num_processes 4 \
    --num_machines 1 \
    --mixed_precision bf16 \
    --dynamo_backend no \
    src/scripts/train.py \
    --parameters.dataset bp4d \
    --parameters.resume-from "${RESUME_CKPT}" \
    --parameters.optimizer.lr 1e-5 \
    --parameters.dataloader.batch-size 16 \
    --parameters.dataloader.num-workers 4 \
    --parameters.gradient-accumulation-steps 5 \
    --parameters.gradient-checkpointing \
    --parameters.no-early-stopping \
    --parameters.lora.enabled \
    --parameters.lora.rank 16
SCRIPT_EXIT=$?

echo "Done, finished at $(date)"
exit $SCRIPT_EXIT
