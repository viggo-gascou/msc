#!/bin/bash

#SBATCH --job-name=semedit-finetune
#SBATCH --output=logs/SLURM/finetune.%j.out
#SBATCH --cpus-per-task=6
#SBATCH --mem=64G
#SBATCH --gres=gpu:a30:4
#SBATCH --time=3-00:00:00
#SBATCH --partition=acltr
#SBATCH --mail-type=BEGIN,END

## SETUP

module load uv/0.7.13-GCCcore-14.2.0

export UV_NO_SYNC=1
export UV_OFFLINE=1
export WANDB_MODE=offline
export WANDB_JOB_TYPE=fine-tuning
export OMP_NUM_THREADS=6
export NO_ALBUMENTATIONS_UPDATE=1

## RUN

echo "Running on $(hostname):"
nvidia-smi --query-gpu=index,gpu_name,memory.total --format=csv,noheader,nounits | awk -F',' '{printf "  GPU %s: %s (%s MiB)\n", $1, $2, $3}'
VRAM_TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | awk '{s+=$1} END {print s}')
echo "Total VRAM: ${VRAM_TOTAL} MiB across $(nvidia-smi --query-gpu=name --format=csv,noheader | wc -l) GPUs"

echo "Activating virtual environment..."
source .venv/bin/activate

PRETRAIN_CKPT=$(ls -d checkpoints/${PRETRAIN_JOB_ID}_* 2>/dev/null | head -1)
if [ -z "$PRETRAIN_CKPT" ]; then
    echo "ERROR: no checkpoint found for job ${PRETRAIN_JOB_ID}"
    exit 1
fi
echo "Using pre-trained checkpoint: ${PRETRAIN_CKPT}"

echo "Setup complete, running script at $(date)"
accelerate launch --multi_gpu \
    --num_processes 4 \
    --num_machines 1 \
    --mixed_precision bf16 \
    --dynamo_backend no \
    src/scripts/train.py \
    --parameters.unet-model "SG161222/Realistic_Vision_V4.0_noVAE" \
    --parameters.dataset bp4d \
    --parameters.adapter-weights "${PRETRAIN_CKPT}/best_au_adapter.safetensors" \
    --parameters.optimizer.lr 1e-5 \
    --parameters.dataloader.batch-size 12 \
    --parameters.dataloader.num-workers 2 \
    --parameters.gradient-accumulation-steps 7 \
    --parameters.lora.enabled \
    --parameters.lora.rank 16
SCRIPT_EXIT=$?

echo "Done, finished at $(date)"
exit $SCRIPT_EXIT
