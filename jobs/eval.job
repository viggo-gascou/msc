#!/bin/bash

#SBATCH --job-name=semedit-eval
#SBATCH --output=logs/SLURM/eval.%j.out
#SBATCH --cpus-per-task=6
#SBATCH --mem=32G
#SBATCH --gres=gpu:rtx6000:1
#SBATCH --time=1-00:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-type=BEGIN,END

## SETUP

module load uv/0.7.13-GCCcore-14.2.0

export UV_NO_SYNC=1
export UV_OFFLINE=1
export OMP_NUM_THREADS=6
export NO_ALBUMENTATIONS_UPDATE=1

# Set MODEL_NAME, DATASET, and EVAL_MODE externally, e.g.:
#   sbatch --export=ALL,MODEL_NAME=sd21_pyfeat_pretrain,DATASET=bp4d,EVAL_MODE=emotion jobs/eval.job
#   sbatch --export=ALL,MODEL_NAME=sd21_pyfeat_pretrain,DATASET=bp4d,EVAL_MODE=paired jobs/eval.job
MODEL_NAME="${MODEL_NAME:-sd21_pyfeat_pretrain}"
DATASET="${DATASET:-bp4d}"
EVAL_MODE="${EVAL_MODE:-emotion}"
MODEL_DIR="models/${MODEL_NAME}"
# Derive detector from second field of model name (sd21_pyfeat_pretrain -> pyfeat)
DETECTOR=$(echo "${MODEL_NAME}" | cut -d_ -f2)
DETECT_VENV=".venv-${DETECTOR}"
SHARD_IDX="${SHARD_IDX:-0}"
NUM_SHARDS="${NUM_SHARDS:-1}"

## RUN

echo "Running on $(hostname) (shard ${SHARD_IDX}/${NUM_SHARDS}):"
nvidia-smi --query-gpu=index,gpu_name,memory.total --format=csv,noheader,nounits | awk -F',' '{printf "  GPU %s: %s (%s MiB)\n", $1, $2, $3}'

_run_phase() {
    local output_dir="$1"
    local extra_args="$2"
    local eval_mode_arg="$3"

    # Phase 1: generate images
    echo "Phase 1: generating images at $(date)"
    .venv/bin/python src/scripts/eval_quantitative.py \
        --model-dir "${MODEL_DIR}" \
        --dataset "${DATASET}" \
        --output-dir "${output_dir}" \
        --num-samples 500 \
        --num-steps 300 \
        --strength 0.5 \
        --au-scale 1.0 \
        --guidance-scale 3.0 \
        --eval-mode "${eval_mode_arg}" \
        ${extra_args} \
        --shard-idx "${SHARD_IDX}" \
        --num-shards "${NUM_SHARDS}"
    local exit_code=$?
    [ $exit_code -ne 0 ] && { echo "Phase 1 failed"; return $exit_code; }

    if [ "${NUM_SHARDS}" -gt 1 ] && [ "${SHARD_IDX}" -ne 0 ]; then
        echo "Shard ${SHARD_IDX} done. Run detection and metrics once all shards complete."
        return 0
    fi

    if [ "${NUM_SHARDS}" -gt 1 ]; then
        echo "Merging shard metadata at $(date)"
        OUTPUT_DIR_MERGE="${output_dir}" NUM_SHARDS_MERGE="${NUM_SHARDS}" \
            .venv/bin/python - <<'EOF'
import os, pandas as pd
from pathlib import Path
output_dir = Path(os.environ["OUTPUT_DIR_MERGE"])
num_shards = int(os.environ["NUM_SHARDS_MERGE"])
shards = [pd.read_parquet(output_dir / f"metadata_shard{i}.parquet") for i in range(num_shards)]
pd.concat(shards, ignore_index=True).to_parquet(output_dir / "metadata.parquet", index=False)
print(f"Merged {num_shards} shards -> metadata.parquet")
EOF
    fi

    # Phase 2: detect AUs
    echo "Phase 2: detecting AUs at $(date)"
    "${DETECT_VENV}/bin/python" src/scripts/detect_generated_aus.py \
        --images-dir "${output_dir}/generated" \
        --detector "${DETECTOR}" \
        --output "${output_dir}/au_detections.parquet"
    exit_code=$?
    [ $exit_code -ne 0 ] && { echo "Phase 2 failed"; return $exit_code; }

    # Phase 3: compute AU metrics
    echo "Phase 3: computing AU metrics at $(date)"
    .venv/bin/python src/scripts/eval_quantitative.py \
        --output-dir "${output_dir}" \
        --au-detections "${output_dir}/au_detections.parquet" \
        --eval-mode "${eval_mode_arg}" \
        --metrics-only
    exit_code=$?
    [ $exit_code -ne 0 ] && { echo "Phase 3 failed"; return $exit_code; }
    return 0
}

if [ "${EVAL_MODE}" = "paired" ]; then
    if [ "${DATASET}" != "bp4d" ]; then
        echo "EVAL_MODE=paired requires DATASET=bp4d, got DATASET=${DATASET}"
        exit 1
    fi
    echo "=== Mode: paired ==="
    _run_phase "eval/${MODEL_NAME}_${DATASET}_paired" "--min-au-distance 2.0" "paired"
    exit $?
else
    for AU_BASELINE in zero source; do
        echo "=== Mode: emotion  Baseline: ${AU_BASELINE} ==="
        _run_phase \
            "eval/${MODEL_NAME}_${DATASET}_${AU_BASELINE}" \
            "--au-baseline ${AU_BASELINE}" \
            "emotion"
        SCRIPT_EXIT=$?
        [ $SCRIPT_EXIT -ne 0 ] && exit $SCRIPT_EXIT
    done
fi

echo "Done, finished at $(date)"
exit 0
