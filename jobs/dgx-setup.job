#!/bin/bash

#SBATCH --job-name=semedit-dgx-setup
#SBATCH --output=logs/SLURM/dgx-setup.%j.out
#SBATCH --cpus-per-task=8
#SBATCH --mem=0
#SBATCH --time=02:00:00
#SBATCH --partition=dgx1
#SBATCH --account=researchers
#SBATCH --nodelist=dgx1

# Prepend the dgx-specific uv dir so it shadows the x86_64 login-node uv.
DGX_UV_DIR="$HOME/.local/bin-dgx"
export PATH="$DGX_UV_DIR:$HOME/.local/bin:$PATH"

echo "Running on $(hostname):"
nvidia-smi --query-gpu=index,gpu_name,memory.total --format=csv,noheader,nounits | awk -F',' '{printf "  GPU %s: %s (%s MiB)\n", $1, $2, $3}'

# The login node is x86_64 but dgx1 is aarch64, so the shared uv won't run here.
# Install an aarch64 uv into a dgx-specific dir using UV_UNMANAGED_INSTALL.
UV="$DGX_UV_DIR/uv"
if ! "$UV" --version &>/dev/null; then
    echo "Installing aarch64 uv to $DGX_UV_DIR..."
    mkdir -p "$DGX_UV_DIR"
    curl -LsSf https://astral.sh/uv/install.sh | env UV_UNMANAGED_INSTALL="$DGX_UV_DIR" sh
    echo "Installed $("$UV" --version)"
fi

export UV_PROJECT_ENVIRONMENT=".venv-dgx"

echo "Syncing dependencies with uv..."
"$UV" sync

echo "Verifying PyTorch GPU access..."
"$UV" run python - <<'EOF'
import torch
print(f"PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"GPU: {torch.cuda.get_device_name(0)}")
    print(f"CUDA capability: {torch.cuda.get_device_capability(0)}")
EOF

echo "Done at $(date)"
