#!/bin/bash

#SBATCH --job-name=pyfeat-bp4d
#SBATCH --output=logs/SLURM/pyfeat-bp4d.%A_%a.out
#SBATCH --cpus-per-task=8
#SBATCH --mem=28G
#SBATCH --gres=gpu:a100_40gb:1
#SBATCH --time=8:00:00
#SBATCH --partition=scavenge
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=0-3
#SBATCH --mail-type=BEGIN,END

## SETUP

module load uv/0.7.13-GCCcore-14.2.0

export NO_ALBUMENTATIONS_UPDATE=1
export UV_HTTP_TIMEOUT=600

# Each array task processes 2 tasks sequentially
TASK_PAIRS=(T1,T2 T3,T4 T5,T6 T7,T8)
IFS=',' read -ra TASKS <<< "${TASK_PAIRS[$SLURM_ARRAY_TASK_ID]}"

echo "Running on $(hostname), tasks ${TASKS[*]}:"
nvidia-smi --query-gpu=index,gpu_name,memory.total --format=csv,noheader,nounits | awk -F',' '{printf "  GPU %s: %s (%s MiB)\n", $1, $2, $3}'
source .venv-pyfeat/bin/activate

SCRIPT_EXIT=0
for TASK in "${TASKS[@]}"; do
    echo "Starting task ${TASK} at $(date)"
    python src/scripts/pyfeat_bp4d.py \
        --sequences-dir /home/semedit/data/BP4D/Sequences \
        --index data/BP4D/bp4d_index.parquet \
        --output-dir data/BP4D/pyfeat \
        --task "$TASK" \
        --batch-size 128 \
        --num-workers 4
    EXIT=$?
    [ $EXIT -ne 0 ] && SCRIPT_EXIT=$EXIT
done

echo "Done, finished at $(date)"
exit $SCRIPT_EXIT
