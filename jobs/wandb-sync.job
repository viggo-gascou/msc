#!/bin/bash

#SBATCH --job-name=wandb-sync
#SBATCH --output=logs/SLURM/wandb-sync.%j.out
#SBATCH --time=1-00:00:00
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=4G
#SBATCH --partition=scavenge

# Pass job IDs to watch as a colon-separated string, e.g.:
#   sbatch --export=ALL,WATCH_JOBS="123:456" jobs/wandb-sync.job
WATCH_JOBS="${WATCH_JOBS:-}"

source .venv/bin/activate

set -a; source .env; set +a

while true; do
    wandb sync "${WANDB_DIR}"/wandb/latest-run

    if [ -n "$WATCH_JOBS" ]; then
        running=$(squeue --jobs="${WATCH_JOBS//:/ }" --noheader 2>/dev/null | wc -l)
        [ "$running" -eq 0 ] && break
    fi

    sleep 300
done

# Final sync once all jobs are done
wandb sync "${WANDB_DIR}"/wandb/latest-run
