        <mxCell id="m_eQu4X-JdzwJI60fanE-120" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="CIFAR10" vertex="1">
          <mxGeometry height="40" width="80" x="680" y="1300" as="geometry" />
        </mxCell>
